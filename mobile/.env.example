# Copy to .env and set your computer's LAN IP (the server prints it on startup).
# Your phone and computer must be on the same Wi-Fi.
EXPO_PUBLIC_SIGNALING_URL=ws://192.168.1.10:3001/ws

# Optional: ICE servers as JSON (add TURN in Step 2).
# EXPO_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
