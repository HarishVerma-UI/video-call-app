{
  "expo": {
    "name": "Huddle",
    "slug": "huddle-video-call",
    "scheme": "huddle",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#13121a",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.harishverma.huddle",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["audio", "voip"],
        "NSFaceIDUsageDescription": "Huddle uses Face ID so you can sign in with your face instead of a password."
      }
    },
    "android": {
      "package": "com.harishverma.huddle",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.USE_BIOMETRIC"
      ]
    },
    "plugins": [
      [
        "expo-local-authentication",
        { "faceIDPermission": "Huddle uses Face ID so you can sign in with your face instead of a password." }
      ],
      [
        "expo-secure-store",
        { "faceIDPermission": "Huddle uses Face ID to unlock your sign-in key." }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Huddle uses your camera so people in the call can see you.",
          "microphonePermission": "Huddle uses your microphone so people in the call can hear you."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
