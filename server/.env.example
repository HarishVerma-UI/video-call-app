# Copy to server/.env (loaded automatically). Real environment variables take precedence.

# MongoDB. Local:  docker compose up -d mongo   → mongodb://localhost:27017
# Or a MongoDB Atlas URI: mongodb+srv://user:pass@cluster.xxxxx.mongodb.net
# Leave empty in development to use a temporary in-memory store.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=huddle

# JWT signing secret: at least 32 random characters. Required in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Token lifetime: e.g. 7d, 12h, 30m
JWT_EXPIRES_IN=7d

# Days to keep saved call chat (MongoDB deletes older messages automatically).
CHAT_RETENTION_DAYS=30

# Admin dashboard sign-in. Defaults to admin/admin — CHANGE ADMIN_PASSWORD before going live.
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin
ADMIN_NAME=Administrator

# Public base URL, used to build social-login redirect URIs (e.g. https://huddle.example.com).
# Leave empty in development; it is derived from the request.
APP_URL=

# Social login (optional). Fill in a provider's id + secret to show its button on the sign-in page.
# Register the callback URL  <APP_URL>/api/auth/oauth/google/callback  (and .../github/callback)
# in the Google Cloud Console / GitHub Developer settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Media uploads (photos, CVs, post images) stored in AWS S3.
# Create a bucket and an IAM user with access to it, then fill these in.
# With them unset, uploads are disabled but the rest of the app works.
AWS_REGION=ap-southeast-2
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

PORT=3001
HOST=0.0.0.0
# Maximum people per meeting (mesh WebRTC gets heavy past ~10).
MAX_PEERS=10
# Comma-separated browser origins allowed to call the API / open the WebSocket, or *.
ALLOWED_ORIGINS=*
# Set to true behind nginx/Caddy/a load balancer so rate limits use the real client IP.
TRUST_PROXY=false
