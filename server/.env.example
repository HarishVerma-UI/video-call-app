# All optional. Set as environment variables, e.g.  PORT=4000 npm start
# (Node 22+: node --env-file=.env src/index.js)
PORT=3001
HOST=0.0.0.0
# Max people per room (mesh calls get heavy past ~6).
MAX_PEERS=6
# Comma-separated browser origins allowed to open the WebSocket, or *.
ALLOWED_ORIGINS=*
# Where the built web app lives (served at /).
# WEB_DIST=../web/dist
