# Copy to .env.local to override. Both are optional.

# Signaling server WebSocket URL. Default: same host as the page (/ws),
# which the Vite dev server proxies to the Node server on :3001.
# VITE_SIGNALING_URL=wss://calls.example.com/ws

# ICE servers as JSON. Add your TURN server here (Step 2) so calls work across strict networks.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
